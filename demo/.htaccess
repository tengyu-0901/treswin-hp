# ──── 基幹システム デモ環境（ダミーデータのみ・本番データには接続しない） ────
<IfModule mod_headers.c>
    # 検索エンジンに載せない
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    # 外部へ参照元URLを送らない
    Header always set Referrer-Policy "no-referrer"
    # サイト共通のCSPに、PDF・Word作成用のライブラリ（cdnjs・jsdelivr）を追加。データ通信はしないので connect-src は自サイトのみ
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; frame-ancestors 'none';"
</IfModule>
